COMMAND: /ZPOOL/data/tools/anaconda/tug87422/envs/sharedreward-phase0/bin/python -c $'\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport nibabel as nib\n\nroot = Path.cwd()\nmean = "L3-mean-activation-20261019-171229"\ncoverage = "vmpfc-support-20261019-171229"\nout = root / "qc/inspection" / os.environ["EXPORT_LABEL"]\nmean_reports = root / "logs/records/L3-preliminary" / mean\ncoverage_reports = root / "logs/records/vmpfc-support" / coverage\n\nassert not out.exists(), f"Destination already exists: {out}"\nfor report in (mean_reports, coverage_reports):\n    result = json.loads((report / "completion.json").read_text())\n    assert result["complete"], f"Incomplete source analysis: {report}"\n\nfiles = []\ndef include(source, destination):\n    source = Path(source)\n    assert source.is_file(), f"Missing source: {source}"\n    files.append((source, Path(destination)))\n\nfor cope in (10, 11, 12):\n    model = f"mean_act_cope-{cope}"\n    base = root / "derivatives/fsl/L3-preliminary" / mean / model\n    feat = base / "L3.gfeat/cope1.feat"\n    for name in ("directory-mask.nii.gz", "analysis-mask.nii.gz"):\n        include(base / name, f"activation/{model}/{name}")\n    for name in ("design.fsf", "design.mat", "design.con",\n                 "mask.nii.gz", "stats/smoothness"):\n        include(feat / name, f"activation/{model}/fitted/{name}")\n    for contrast in (1, 2):\n        for name in (\n            f"stats/cope{contrast}.nii.gz",\n            f"stats/varcope{contrast}.nii.gz",\n            f"stats/zstat{contrast}.nii.gz",\n            f"thresh_zstat{contrast}.nii.gz",\n            f"cluster_mask_zstat{contrast}.nii.gz",\n        ):\n            include(feat / name, f"activation/{model}/fitted/{name}")\n\ncoverage_root = root / "derivatives/qc/vmpfc-support" / coverage\nmodels = sorted(p for p in coverage_root.iterdir() if p.is_dir())\nassert len(models) == 16, f"Expected 16 coverage models, found {len(models)}"\nfor model in models:\n    include(model / "vmpfc-roi.nii.gz", f"coverage/{model.name}/vmpfc-roi.nii.gz")\n    for dataset in ("pooled", "rf1", "ds003745"):\n        for kind in ("mask", "support"):\n            name = f"{dataset}_{kind}-frequency.nii.gz"\n            include(model / name, f"coverage/{model.name}/{name}")\n\ninclude(\n    root.parent / "rf1-sra-sharedreward/resources/rf1_MNI152NLin6Asym_reference_grid.nii.gz",\n    "reference/reference-grid.nii.gz",\n)\ninclude("/usr/local/fsl/data/standard/MNI152_T1_2mm.nii.gz",\n        "reference/MNI152_T1_2mm.nii.gz")\nfor name in ("seed-vs.nii.gz", "VMPFC-mask-neurovault-resliced-bin.nii.gz"):\n    include(root / "masks" / name, f"reference/{name}")\n\nfor name in ("completion.json", "analysis-support.tsv", "roi-results.tsv"):\n    include(mean_reports / name, f"reports/activation/{name}")\nfor name in ("completion.json", "model-coverage-summary.tsv",\n             "participant-coverage.tsv", "vmpfc-coverage-summary.png"):\n    include(coverage_reports / name, f"reports/coverage/{name}")\ninclude(root / "qc/L3-preliminary" / mean / "mean-roi.png",\n        "reports/activation/mean-roi.png")\n\ntotal = sum(source.stat().st_size for source, _ in files)\nassert total <= 40 * 1024**2, f"Export exceeds 40 MB: {total/1024**2:.1f} MB"\nfor source, destination in files:\n    assert source.stat().st_size <= 5 * 1024**2, f"Unexpectedly large file: {source}"\n    if source.name.endswith(".nii.gz"):\n        assert len(nib.load(source).shape) == 3, f"Refusing non-3D image: {source}"\n\nout.mkdir(parents=True)\nmanifest = []\nfor source, relative in files:\n    data = source.read_bytes()\n    destination = out / relative\n    destination.parent.mkdir(parents=True, exist_ok=True)\n    destination.write_bytes(data)\n    digest = hashlib.sha256(data).hexdigest()\n    assert hashlib.sha256(destination.read_bytes()).hexdigest() == digest\n    manifest.append(dict(source=str(source), file=str(relative),\n                         bytes=len(data), sha256=digest))\n\nrecord = dict(\n    complete=True,\n    source_mean_analysis=mean,\n    source_coverage_analysis=coverage,\n    git_commit=subprocess.check_output(\n        ["git", "rev-parse", "HEAD"], text=True\n    ).strip(),\n    files=manifest,\n    total_bytes=total,\n)\n(out / "export-manifest.json").write_text(json.dumps(record, indent=2) + "\\n")\nprint(f"CHECK PASSED: {len(files)} files, {total/1024**2:.2f} MB")\nprint(f"Inspection bundle: {out}")\nprint("Original derivatives unchanged.")\n' 

